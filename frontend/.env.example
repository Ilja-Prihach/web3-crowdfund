# Необязательный Sepolia RPC URL. Пустое значение — публичный узел publicnode.
# Не вставляйте сюда URL с приватным API-ключом: NEXT_PUBLIC_ попадает в браузер.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Адрес backend для прокси /api/* в разработке. Только для сервера Next: без NEXT_PUBLIC_, в браузер не попадает.
# Пусто — http://127.0.0.1:4000, как у backend/.env.example.
BACKEND_URL=

{
  "name": "openfund-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "storybook": "storybook dev -p 6006 --no-open --host 127.0.0.1",
    "storybook:build": "storybook build",
    "storybook:test": "vitest run --config vitest.config.ts",
    "optimize:images": "node scripts/optimize-images.mjs",
    "abi:export": "node scripts/export-abi.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.13",
    "wagmi": "3.7.9"
  },
  "overrides": {
    "@storybook/react-vite": {
      "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-mcp": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/nextjs-vite": "10.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "1.65.1",
    "sass": "1.106.1",
    "sharp": "0.35.5",
    "storybook": "10.6.9",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}

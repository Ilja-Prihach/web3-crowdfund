# Локальный PostgreSQL из compose.yaml в корне репозитория.
DATABASE_URL=postgres://openfund:openfund@127.0.0.1:5433/openfund

# Узел Sepolia для чтения контракта. Публичный узел без ключа подходит для разработки,
# но обрезает историю логов (docs/gotchas.md); indexer'у нужен провайдер с ключом.
# Значение с ключом хранится только в .env и не логируется.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Источник frontend: из него берутся ожидаемые domain и uri сообщения входа SIWE.
# Ровно источник, без пути и косой черты в конце; http — только для localhost.
APP_ORIGIN=http://localhost:3000

# Локальный PostgreSQL из compose.yaml в корне репозитория.
DATABASE_URL=postgres://openfund:openfund@127.0.0.1:5433/openfund

# Узел Sepolia для чтения контракта и истории событий. 1rpc без ключа хранит всю историю,
# но отдаёт логи окнами по 50 блоков и иногда отвечает -32029 (docs/DECISIONS.md#indexer-reads-history-from-public-1rpc).
# URL провайдера с ключом хранится только в .env и не логируется.
SEPOLIA_RPC_URL=https://1rpc.io/sepolia

# Источник frontend: из него берутся ожидаемые domain и uri сообщения входа SIWE.
# Ровно источник, без пути и косой черты в конце; http — только для localhost.
APP_ORIGIN=http://localhost:3000

# Адреса или CIDR reverse proxy, которому backend верит в X-Forwarded-For, через запятую.
# Пусто — доверия нет: лимиты считаются по адресу соединения. Подробности — docs/DECISIONS.md.
# TRUST_PROXY=10.0.0.5

{
  "name": "openfund-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "abi:export": "node scripts/export-abi.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/type-provider-typebox": "6.3.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "typebox": "1.4.3",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
